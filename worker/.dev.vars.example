# انسخ هذا الملف إلى worker/.dev.vars واملأ ما لديك. لا ترفع .dev.vars إلى Git.
# رمز يكتبه الطالبان مرة واحدة في الإعدادات. اختر رمزاً طويلاً.
ACCESS_CODE=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
COHERE_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
# وثائق Mistral متعارضة بشأن المجانية. لا يعمل إلا بعد تأكدك: MISTRAL_CONFIRMED_FREE=true
MISTRAL_API_KEY=
MISTRAL_CONFIRMED_FREE=

# لتغيير نموذج: GEMINI_MODEL=... أو GEMINI_EMBED_MODEL=...

# حسابات الطالبين (المرحلة الأولى):
# سر عشوائي طويل (32 حرفاً فأكثر) يدخل في تجزئة كلمات المرور. لا يُغيَّر بعد إنشاء الحسابات وإلا بطلت كلماتها.
PASSWORD_PEPPER=
# رمز الإعداد الأول: يُكتب مرة واحدة في صفحة الإعداد لإنشاء حساب المسؤول.
SETUP_CODE=
# اختياري: رمز المكتبة، فتُفتح الكتب تلقائياً للطالب بعد دخوله.
LIBRARY_CODE=
# مفتاح تشفير مفاتيح الذكاء الاصطناعي التي يضيفها المسؤول من اللوحة (32 بايتاً عشوائياً base64url فأكثر):
KEYS_SECRET=
# مفاتيح إضافية للمزود نفسه في متغيرات منفصلة: GEMINI_API_KEY_2= ثم GEMINI_API_KEY_3= …
